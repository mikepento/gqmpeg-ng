#: src/ipc.c:324
msgid "play, pause, stop, next, prev, quit\n"
msgstr ""

#: src/ipc.c:325
msgid "seek [+|-]n                seek n seconds into file, or +/-n\n"
msgstr "seek [+|-]n                ファイルの n 秒目にシーク、あるいは +/-n\n"

#: src/ipc.c:326
msgid "pladd {\"file\"|file}        add file to playlist\n"
msgstr "pladd {\"file\"|file}        演奏リストに file を追加\n"

#: src/ipc.c:327
msgid "pladd_play {\"file\"|file}   add file to playlist and play it\n"
msgstr "pladd_play {\"file\"|file}   演奏リストに file を追加し、それを演奏\n"

#: src/ipc.c:328
msgid "plremove {\"file\"|file}     remove file from playlist\n"
msgstr "plremove {\"file\"|file}     演奏リストから file を削除\n"

#: src/ipc.c:329
msgid "plclr                      clear playlist\n"
msgstr "plclr                      演奏リストを消去\n"

#: src/ipc.c:330
msgid "plload {playlist}          load playlist\n"
msgstr "plload {playlist}          演奏リストを開く\n"

#: src/ipc.c:331
msgid "plappend {playlist}        append playlist\n"
msgstr "plappend {playlist}        演奏リストを追加\n"

#: src/ipc.c:332
msgid "play_file {\"file\"|file}    play file, do not add to playlist\n"
msgstr "play_file {\"file\"|file}    file を演奏、演奏リストへは追加しない\n"

#: src/ipc.c:333
msgid "                           or, if playlist, load playlist\n"
msgstr "                           または、演奏リストなら開く\n"

#: src/ipc.c:334
msgid "   file is a path or http://server:port\n"
msgstr "   ファイルはパスか http://server:port\n"

#: src/ipc.c:335
msgid "skin \"file\"                set skin\n"
msgstr "skin \"file\"                スキンを指定\n"

#: src/ipc.c:336
msgid "volume [+|-]n              set volume to n (0 - 100) or +/-n\n"
msgstr ""
"volume [+|-]n              ボリュームを n (0 - 100) に設定、または +/-n\n"

#: src/ipc.c:337
msgid "getting a status printed to a file is also possible:\n"
msgstr "状態を取得してファイルへ出力することも可能です:\n"

#: src/ipc.c:338
msgid "status_add \"key\" \"file\"    start status printing to file\n"
msgstr "status_add \\\"key\\\" \\\"file\\\"    ファイルへの状態出力を開始\n"

#: src/ipc.c:339
msgid "status_rm \"key\"|\"file\"     stop printing to file or key\n"
msgstr ""
"status_rm \\\"key\\\"|\\\"file\\\"     ファイルまたは key への出力を停止\n"

