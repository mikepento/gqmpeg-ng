msgid "  -h,  --help                  displays this message\n"
msgstr "  -h,  --help                   afficher ce message\n"

#: src/main.c:929
msgid "  -v,  --version               shows version info\n"
msgstr "  -v,  --version                afficher les informations de version\n"

#: src/main.c:930
msgid "  --blank                      start with empty playlist\n"
msgstr ""
"  --blank                       commencer avec une liste de lecture vide\n"

