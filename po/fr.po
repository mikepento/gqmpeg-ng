msgstr "Usage : gqmpeg [option(s)] [fichier(s) | commande(s)_ipc]\n"

#: src/main.c:922
msgid " standard options:\n"
msgstr " Options standards :\n"

#: src/main.c:923
msgid "  --skin:<skindir>             load specified skin\n"
msgstr "  --skin:<répertoire_skin>      charger le revêtement spécifié\n"

#: src/main.c:924
msgid "  --dock                       enable docking behavior\n"
msgstr "  --dock                        autoriser le mode dock\n"

#: src/main.c:925
msgid "  --dockwm                     enable Window Maker docking\n"
msgstr ""
"  --dockwm                      autoriser le mode dock de Window Maker\n"

#: src/main.c:926
msgid "  --skinhelp                   print mouse event coordinates\n"
msgstr ""
"  --skinhelp                    afficher les coordonnées des évènements "
