#: src/ipc.c:323
msgid "available ipc commands:\n"
msgstr "commandes IPC disponibles :\n"

#: src/ipc.c:324
msgid "play, pause, stop, next, prev, quit\n"
msgstr "play, pause, stop, next, prev, quit\n"

#: src/ipc.c:325
msgid "seek [+|-]n                seek n seconds into file, or +/-n\n"
msgstr ""
"seek [+|-]n                       avancer de n secondes dans le fichier, ou "
"+/-n\n"

#: src/ipc.c:326
msgid "pladd {\"file\"|file}        add file to playlist\n"
msgstr ""
"pladd {\"fichier\"|fichier}       ajouter le fichier à la liste de lecture\n"

#: src/ipc.c:327
msgid "pladd_play {\"file\"|file}   add file to playlist and play it\n"
msgstr ""
"pladd_play {\"fichier\"|fichier}  ajouter le fichier à la liste de lecture "
"et le jouer\n"

#: src/ipc.c:328
msgid "plremove {\"file\"|file}     remove file from playlist\n"
msgstr ""
"plremove {\"fichier\"|fichier}    enlever le fichier de la liste de lecture\n"

#: src/ipc.c:329
msgid "plclr                      clear playlist\n"
msgstr "plclr                             effacer la liste de lecture\n"

#: src/ipc.c:330
msgid "plload {playlist}          load playlist\n"
msgstr "plload {playlist}                 charger la liste de lecture\n"

#: src/ipc.c:331
msgid "plappend {playlist}        append playlist\n"
msgstr "plappend {playlist}               ajouter à la liste de lecture\n"

#: src/ipc.c:332
msgid "play_file {\"file\"|file}    play file, do not add to playlist\n"
msgstr ""
"play_file {\"fichier\"|fichier}          jouer le fichier sans l'ajouter à "
"la liste de lecture\n"

#: src/ipc.c:333
msgid "                           or, if playlist, load playlist\n"
msgstr ""
"                                  ou si c'est une liste de lecture, la "
"charger\n"

#: src/ipc.c:334
msgid "   file is a path or http://server:port\n"
msgstr "   fichier est un chemin ou http://serveur:port\n"

#: src/ipc.c:335
msgid "skin \"file\"                set skin\n"
msgstr "skin \"fichier\"                 utiliser le revêtement spécifié\n"

#: src/ipc.c:336
msgid "volume [+|-]n              set volume to n (0 - 100) or +/-n\n"
msgstr ""
"volume [+|-]n                    positionner le volume à n (0 - 100) ou +/-"
"n\n"

#: src/ipc.c:337
msgid "getting a status printed to a file is also possible:\n"
msgstr "récupérer un état dans un fichier est aussi possible :\n"

#: src/ipc.c:338
msgid "status_add \"key\" \"file\"    start status printing to file\n"
msgstr ""
"status_add \"clé\" \"fichier\"     commencer à écrire l'état dans un "
"fichier\n"

#: src/ipc.c:339
msgid "status_rm \"key\"|\"file\"     stop printing to file or key\n"
msgstr ""
"status_rm \"clé\"|\"fichier\"      arrêter l'écriture dans un fichier ou une "
"clé\n"

